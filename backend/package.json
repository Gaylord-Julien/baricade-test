{
  "name": "backend",
  "version": "0.0.1",
  "description": "REST API for door-to-door canvassing in Rouen",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint:fix": "eslint . --fix",
    "seed:generate": "node scripts/generate-interest-points-seed.ts",
    "openapi:export": "nest build && node dist/openapi/export-openapi-document.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
